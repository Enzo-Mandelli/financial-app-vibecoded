<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pw_fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Topo: config à esquerda, editar registros à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConfig"
                style="@style/Pixel.Botao.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_neutro"
                android:text="CONFIG" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnEditar"
                style="@style/Pixel.Botao.Pequeno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDITAR" />
        </LinearLayout>

        <TextView
            style="@style/Pixel.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="PIXEL WALLET" />

        <!-- Saldo do dia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_painel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Pixel.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SALDO DE HOJE"
                android:textColor="@color/pw_texto_fraco" />

            <TextView
                android:id="@+id/txtSaldo"
                style="@style/Pixel.Texto"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:maxLines="1"
                android:shadowColor="@color/pw_preto"
                android:shadowDx="4"
                android:shadowDy="4"
                android:shadowRadius="0.01"
                android:textColor="@color/pw_verde"
                android:textSize="24sp"
                android:text="R$ 0,00" />

            <TextView
                android:id="@+id/txtStatus"
                style="@style/Pixel.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/pw_destaque"
                android:textSize="8sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtDiaria"
            style="@style/Pixel.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtGastoMes"
            style="@style/Pixel.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtGanhoMes"
            style="@style/Pixel.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pw_verde"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtDia"
            style="@style/Pixel.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pw_texto_fraco" />

        <com.pixelwallet.ui.BarraDoMes
            android:id="@+id/barraMes"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp" />

        <!-- Registrar gasto -->
        <EditText
            android:id="@+id/campoValor"
            style="@style/Pixel.Campo.Dinheiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnRegistrar"
            style="@style/Pixel.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="&gt; REGISTRAR GASTO" />

        <!-- Mesmo campo: dinheiro que entrou fora da renda (Pix, freela...) -->
        <Button
            android:id="@+id/btnGanho"
            style="@style/Pixel.Botao.Pequeno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_ganho"
            android:text="+ GANHO EXTRA" />

        <TextView
            style="@style/Pixel.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:textSize="10sp"
            android:text="HOJE" />

        <LinearLayout
            android:id="@+id/listaHoje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/txtVazioHoje"
            style="@style/Pixel.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="NADA REGISTRADO HOJE"
            android:textColor="@color/pw_texto_fraco"
            android:textSize="8sp" />
    </LinearLayout>
</ScrollView>
