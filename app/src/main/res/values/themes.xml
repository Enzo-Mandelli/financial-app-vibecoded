<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PixelWallet" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/pw_painel</item>
        <item name="colorPrimaryDark">@color/pw_fundo</item>
        <item name="colorAccent">@color/pw_amarelo</item>
        <item name="android:windowBackground">@color/pw_fundo</item>
        <item name="android:statusBarColor">@color/pw_fundo</item>
        <item name="android:navigationBarColor">@color/pw_fundo</item>
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/pw_texto</item>
        <item name="android:textColorHint">@color/pw_texto_fraco</item>
    </style>

    <style name="Pixel" />

    <style name="Pixel.Texto">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/pw_texto</item>
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>

    <style name="Pixel.Titulo" parent="Pixel.Texto">
        <item name="android:textColor">@color/pw_amarelo</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Pixel.Botao" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/pw_texto</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:background">@drawable/btn_primario</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:shadowColor">@color/pw_preto</item>
        <item name="android:shadowDx">3</item>
        <item name="android:shadowDy">3</item>
        <item name="android:shadowRadius">0.01</item>
    </style>

    <style name="Pixel.Botao.Pequeno">
        <item name="android:textSize">9sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="Pixel.Campo">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textColor">@color/pw_texto</item>
        <item name="android:textColorHint">@color/pw_texto_fraco</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:padding">16dp</item>
        <item name="android:textCursorDrawable">@drawable/cursor_pixel</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Pixel.Campo.Dinheiro">
        <item name="android:inputType">number</item>
        <item name="android:hint">R$ 0,00</item>
        <item name="android:imeOptions">actionDone</item>
    </style>
</resources>
