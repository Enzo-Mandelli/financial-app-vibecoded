<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/pw_botao_neutro" />
                    <stroke android:width="3dp" android:color="@color/pw_preto" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <solid android:color="@color/pw_preto" />
                </shape>
            </item>
            <item android:right="4dp" android:bottom="4dp">
                <shape>
                    <solid android:color="@color/pw_botao_neutro" />
                    <stroke android:width="3dp" android:color="@color/pw_preto" />
                </shape>
            </item>
            <!-- brilho de 1 "pixel" no topo -->
            <item android:left="3dp" android:top="3dp" android:right="7dp"
                android:height="3dp" android:gravity="top">
                <shape>
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
